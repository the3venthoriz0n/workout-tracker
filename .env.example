# Local development only. `just setup` copies this to .env and fills in random secrets.
# Never commit .env. Production secrets are generated on the server by deploy/deploy.sh.
POSTGRES_USER=workout
POSTGRES_PASSWORD=
POSTGRES_DB=workout
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# --- Optional (uncomment to use). Not needed for normal development. ---
# Real email in dev (set BOTH; leave unset and verification/reset links are printed in the API log
# with a [mail] prefix instead). Needs a sender on a domain verified in Resend.
# RESEND_API_KEY=
# MAIL_FROM=no-reply@example.invalid
# Only these emails may create an account (comma separated). Unset or empty: open sign-up.
# SIGNUP_ALLOWLIST=
# Set to off to disable the per-IP rate limit of the public community area (load testing; ignored in production).
# AUTH_RATE_LIMIT=on
# Dev web port bind address. Default 0.0.0.0 (reachable from your LAN, e.g. a phone); 127.0.0.1 = this machine only.
# DEV_BIND=0.0.0.0
# Extra host names Vite may be opened by, comma separated (IP addresses always work).
# DEV_ALLOWED_HOSTS=
