# Local development only. `just setup` copies this to .env and fills in random secrets.
# Never commit .env. Production secrets are generated on the server by deploy/deploy.sh.
POSTGRES_USER=workout
POSTGRES_PASSWORD=
POSTGRES_DB=workout
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# --- Optional (uncomment to use). Not needed for normal development. ---
# Real email in dev (set BOTH; leave unset and set-up/reset links are printed in the API log
# with a [mail] prefix instead). Needs a sender on a domain verified in Resend.
# RESEND_API_KEY=
# MAIL_FROM=no-reply@example.invalid
# The AI that estimates nutrition (Nutrition tab). Any OpenAI-compatible service works, or Claude;
# leave AI_API_KEY unset and the tab reports AI as unavailable. Set all of the values for your service.
# Google Gemini, for example (get a key in Google AI Studio; run
#   curl -s -H "Authorization: Bearer $AI_API_KEY" https://generativelanguage.googleapis.com/v1beta/openai/models
# to list the exact model ids your key can use, and put one in AI_MODEL):
# AI_PROVIDER=openai
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=
# Other services: Groq `https://api.groq.com/openai/v1`, OpenRouter `https://openrouter.ai/api/v1`, Ollama on
# your own machine `http://host.docker.internal:11434/v1`; for Claude set AI_PROVIDER=anthropic (no base url).
# Your meal text goes to whichever service you configure; free tiers may use it to improve their products.
# Only these emails may create an account (comma separated). Unset or empty: open sign-up.
# SIGNUP_ALLOWLIST=
# "Continue with Google": set both (a Web OAuth client in Google Cloud; redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google). Unset: the button is hidden.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Set to off to disable the per-IP rate limit of the public community area (load testing; ignored in production).
# AUTH_RATE_LIMIT=on
# Dev web port bind address. Default 0.0.0.0 (reachable from your LAN, e.g. a phone); 127.0.0.1 = this machine only.
# DEV_BIND=0.0.0.0
# Extra host names Vite may be opened by, comma separated (IP addresses always work).
# DEV_ALLOWED_HOSTS=
