# Copy to .env next to compose.yaml on the server and fill in every value. chmod 600 .env.
# Never commit .env; this file holds placeholders only.

# Public hostname served through the tunnel, without scheme (the app trusts https://$DOMAIN).
DOMAIN=app.example.invalid

# Name of the existing Docker network the tunnel container (cloudflared) is attached to.
# Find it with: docker inspect <cloudflared container> --format '{{json .NetworkSettings.Networks}}'
TUNNEL_NETWORK=tunnel-network-name

# Database credentials. Generate with: openssl rand -hex 32
POSTGRES_USER=workout
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=workout

# Session signing secret, at least 32 characters. Generate with: openssl rand -hex 32
# Rotating it signs every user out.
BETTER_AUTH_SECRET=replace-with-random-hex

# Comma separated emails allowed to create an account (exact match, case-insensitive).
# The line must exist: compose refuses to start when SIGNUP_ALLOWLIST is missing (so a typo in
# the name cannot silently open sign-up). An explicitly empty value means open sign-up.
# Existing accounts can always sign in.
SIGNUP_ALLOWLIST=owner@example.invalid

# Optional extra allowed origins, comma separated (not needed for the web app).
TRUSTED_ORIGINS=

# IMAGE_REF and PREVIOUS_IMAGE_REF are appended here by deploy.sh after each successful deploy.
# Do not set them by hand.
