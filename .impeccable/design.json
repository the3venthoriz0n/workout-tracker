  "narrative": {
    "northStar": "The Training Log",
    "overview": "A clean, honest logbook that happens to fit in a thumb. Warm off-white paper or deep near-black, ink, one blue for done, active and focus, everything else soft grey fill. Weights and reps are the largest thing on every screen, in tabular numerals. Calm, warm and utilitarian; clean, simple, clear and modern, one-handed on a phone, equally good in dark.",
    "keyCharacteristics": [
      "Numbers first: 26px tabular numerals carry the app.",
      "One accent (blue) for done, active, focus and links.",
      "Soft filled surfaces and generous radii instead of lines and shadows.",
      "44px minimum targets, 68px set rows, a 56px primary pill docked in the thumb zone.",
      "Meaning is never carried by colour alone."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Blue means done, active or focused. If a screen has blue that is not one of those, remove it.",
        "section": "colors"
      },
      {
        "name": "The Never-Colour-Alone Rule",
        "body": "Every state pairs colour with a shape or word: check with fill, arrow with outcome text, dot with day name.",
        "section": "colors"
      },
      {
        "name": "The Both-Themes Rule",
        "body": "Every colour pair is AA-checked in light and dark; a new colour ships with both values.",
        "section": "colors"
      },
      {
        "name": "The Number Is Loud Rule",
        "body": "The set's reps × weight is always the largest type on its row; labels around it are small and muted.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Any figure that changes or aligns uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat at rest; the only shadow is on things that float above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do make the reps × weight the largest thing on a row, in tabular numerals.",
      "Do keep one primary action per screen, docked in the thumb zone with a 44px minimum for every target.",
      "Do pair every colour state with a shape or word, and check every pair in light and dark.",
      "Do use soft fills and generous radii for depth instead of borders and shadows."
    ],
    "donts": [
      "Don't use a second accent colour or put blue on anything that is not done, active or focused.",
      "Don't add swipe-only gestures, or put delete beside the chevron; delete is quiet and icon-only.",
      "Don't add decoration that does not help log a set, plan a day or understand progress.",
      "Don't introduce motion beyond the 150ms colour change and sheet transitions."
    ]
  }
